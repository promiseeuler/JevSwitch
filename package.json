{
  "name": "jevswitch",
  "version": "0.1.0",
  "description": "Find bounded LLM decisions, benchmark them with TypeSafe Jev, and generate safe migrations.",
  "type": "module",
  "bin": {
    "jevswitch": "./dist/src/cli.js"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "files": ["dist/src", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "npm run typecheck && npm test"
  },
  "keywords": ["jev", "typesafe", "system-one", "llm", "ai", "migration", "benchmark", "cli"],
  "author": "Promise Euler",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/promiseeuler/JevSwitch.git"
  },
  "homepage": "https://github.com/promiseeuler/JevSwitch#readme",
  "bugs": { "url": "https://github.com/promiseeuler/JevSwitch/issues" },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
